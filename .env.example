# qwen3-voice-design — server config (copy to .env)

# --- Required -------------------------------------------------------------

# Bearer token clients must send as `Authorization: Bearer <token>`.
# MUST match dashboard-backend's VOICE_DESIGN_API_KEY.
QWEN3_VD_API_KEY=change-me-please

# --- Bind -----------------------------------------------------------------

QWEN3_VD_HOST=127.0.0.1
QWEN3_VD_PORT=8112

# --- Model ----------------------------------------------------------------

QWEN3_VD_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
QWEN3_VD_DEVICE=cuda

# --- Capacity / limits ---------------------------------------------------

# Max concurrent requests. Default 1 — second caller gets server_busy
# immediately, no queueing. Bump to 2-4 to allow queueing at the GPU.
QWEN3_VD_CAP=1

# Max characters per request. 6.7x the previous Chutes 300-char cap.
# At ~80 codec tokens/sec of audio, 2000 chars ≈ 90s of speech.
QWEN3_VD_MAX_CHARS=2000

# KV cache budget per request. 3072 fits the 2000-char text plus the
# ~960-token codec output with headroom on 4090 (24 GB).
QWEN3_VD_MAX_SEQ_LEN=3072

# Hard cap on a single synthesis (seconds). At RTF ~5 on 4090, 2000-char
# text ≈ 18s wall. 120s is generous; lower for faster failure on stuck inference.
QWEN3_VD_SYNTH_TIMEOUT_S=120

# --- Sampling (match faster-qwen3-tts defaults) --------------------------

QWEN3_VD_TEMPERATURE=0.9
QWEN3_VD_TOP_K=50
QWEN3_VD_TOP_P=1.0
QWEN3_VD_REPETITION_PENALTY=1.05
QWEN3_VD_MAX_NEW_TOKENS=4096

# --- Logging --------------------------------------------------------------

QWEN3_VD_LOG_LEVEL=INFO
